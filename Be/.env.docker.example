# Docker demo profile. Copy to Be/.env and fill secret values locally.
PORT=3001
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

RUNTIME_PROFILE=prod
REDIS_ENABLED=true
QUEUE_MODE=redis
WORKER_ENABLED=true
CRON_ENABLED=true

# docker-compose overrides DATABASE_URL to the postgres service.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/service_marketplace?schema=public
# Disposable PostgreSQL database used only by npm run test:integration.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/service_marketplace_test?schema=public

JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=change-me-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/return
VNPAY_IPN_URL=http://localhost:3001/provider-wallets/vnpay/ipn

MAIL_PROVIDER=console
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Service Marketplace" <noreply@marketplace.vn>
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@marketplace.vn
BREVO_SENDER_NAME=Service Marketplace

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_TIMEOUT_MS=5000
AI_RETRY_COUNT=1
