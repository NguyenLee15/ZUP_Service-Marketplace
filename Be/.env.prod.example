# Paid production profile
PORT=3001
NODE_ENV=production
RUNTIME_PROFILE=prod
FRONTEND_URL=https://your-frontend-url.example
CORS_ORIGINS=https://your-frontend-url.example,https://your-admin-url.example
CORS_ALLOWED_HEADERS=Content-Type,Authorization,x-request-id
CORS_CREDENTIALS=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

DATABASE_URL=postgresql://user:password@host:5432/service_marketplace?schema=public&sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/service_marketplace?schema=public&sslmode=require

JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=change-me-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# API service: WORKER_ENABLED=false, CRON_ENABLED=false
# Worker service: WORKER_ENABLED=true, CRON_ENABLED=true
REDIS_ENABLED=true
QUEUE_MODE=redis
WORKER_ENABLED=false
CRON_ENABLED=false
REDIS_URL=rediss://default:password@redis-host:6379

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-frontend-url.example/payment/return
VNPAY_IPN_URL=https://your-backend-url.example/provider-wallets/vnpay/ipn

MAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@your-domain.example
BREVO_SENDER_NAME=Service Marketplace

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_TIMEOUT_MS=5000
AI_RETRY_COUNT=1

# Legacy fallback only. Prefer GEMINI_API_KEY for new deploys.
OPENAI_API_KEY=
