# Free public demo profile
PORT=3001
NODE_ENV=production
RUNTIME_PROFILE=free
FRONTEND_URL=https://your-frontend-url.example
CORS_ORIGINS=https://your-frontend-url.example,https://your-admin-url.example
CORS_ALLOWED_HEADERS=Content-Type,Authorization,x-request-id
CORS_CREDENTIALS=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Supabase pooled connection string for app runtime.
# Use the Transaction Pooler URL from Supabase Dashboard.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Supabase direct connection for Prisma migrate/deploy.
# Use this only for migrations and schema operations, never as the app pooler URL.
DIRECT_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Local/CI only. Do not point integration tests at the production database.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/service_marketplace_test?schema=public

JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=change-me-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth: include web + Android client ids used by frontend/mobile builds.
# Example:
# GOOGLE_CLIENT_IDS=422532889022-1l2maodtv5p9kijh17499ip9g6sbbnlp.apps.googleusercontent.com,422532889022-io4134s1uuc7nstujs97grm3qagfnb2e.apps.googleusercontent.com,422532889022-3r7vkh1lrvutq4ip3e639nska0537s02.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Free mode: no Redis/BullMQ, no worker/cron
REDIS_ENABLED=false
QUEUE_MODE=inline
WORKER_ENABLED=false
CRON_ENABLED=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-frontend-url.example/payment/return
VNPAY_IPN_URL=https://your-render-backend.onrender.com/provider-wallets/vnpay/ipn

# Render Free thường không phù hợp SMTP; dùng Brevo HTTP API.
MAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@your-domain.example
BREVO_SENDER_NAME=Service Marketplace

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_TIMEOUT_MS=5000
AI_RETRY_COUNT=1

# Legacy fallback only. Prefer GEMINI_API_KEY for new deploys.
OPENAI_API_KEY=
