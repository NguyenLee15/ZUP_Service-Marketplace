# ===== Server =====
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ===== Runtime profile =====
# local/free mặc định không cần Redis, phù hợp chạy demo miễn phí.
# prod bật Redis/BullMQ bằng env bên dưới và nên tách API/worker.
RUNTIME_PROFILE=local
REDIS_ENABLED=false
QUEUE_MODE=inline
WORKER_ENABLED=false
CRON_ENABLED=false

# ===== Database (Prisma) =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/service_marketplace?schema=public

# ===== JWT =====
JWT_SECRET=your-jwt-secret-change-me
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# ===== Redis =====
# Chỉ cần khi REDIS_ENABLED=true và QUEUE_MODE=redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Hoặc dùng Upstash:
# REDIS_URL=redis://default:xxx@xxx.upstash.io:6379

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== VNPay Sandbox =====
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/return
VNPAY_IPN_URL=http://localhost:3001/provider-wallets/vnpay/ipn

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ===== Mail =====
# local/free dev: console log OTP/reset link
# hosted free: brevo qua HTTPS API
# prod: brevo hoặc smtp provider tin cậy
MAIL_PROVIDER=console
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Service Marketplace" <noreply@marketplace.vn>
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@marketplace.vn
BREVO_SENDER_NAME=Service Marketplace

# ===== AI (Gemini) =====
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_TIMEOUT_MS=5000
AI_RETRY_COUNT=1

# Legacy fallback only. Prefer GEMINI_API_KEY for new deploys.
OPENAI_API_KEY=
