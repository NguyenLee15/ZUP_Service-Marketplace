// ===== GENERATOR & DATASOURCE =====
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ===== ENUMS =====
enum UserRole {
  ADMIN
  STAFF
  PROVIDER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  LOCKED
  PENDING
}

enum OtpType {
  REGISTER
  RESET_PASSWORD
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceStatus {
  DRAFT
  PENDING
  ACTIVE
  HIDDEN
  REJECTED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  QUOTED
  CONFIRMED
  IN_PROGRESS
  DONE
  DISPUTED
  CANCELLED
}

enum BookingAttachmentType {
  SURVEY
  RESULT
}

enum WalletTransactionType {
  DEPOSIT
  COMMISSION
  PENALTY
  FEATURED_FEE
  WITHDRAWAL
}

enum WalletTransactionStatus {
  SUCCESS
  FAILED
  PENDING
}

enum WalletRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum SenderType {
  CUSTOMER
  PROVIDER
  AI
}

enum DisputeStatus {
  PENDING
  IN_REVIEW
  RESOLVED
}

enum DisputeEvidenceType {
  IMAGE
  VIDEO
}

enum FeaturedListingStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ===== MODELS =====

/// Bảng users — KHÔNG có kycStatus, isLocked, lockUntil, deletedAt
model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique @db.VarChar(100)
  password      String?    @db.VarChar(255)
  googleId      String?    @unique @map("google_id") @db.VarChar(100)
  fullName      String     @map("full_name") @db.VarChar(100)
  phone         String?    @db.VarChar(15)
  avatarUrl     String?    @map("avatar_url") @db.VarChar(255)
  role          UserRole
  status        UserStatus @default(PENDING)
  isOnline      Boolean    @default(true) @map("is_online")
  emailVerified Boolean    @default(false) @map("email_verified")
  permissions   String[]   @default([]) @map("permissions")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relations
  refreshTokens           RefreshToken[]
  passwordResets          PasswordReset[]
  kycProfiles             KycProfile[]           @relation("ProviderKyc")
  reviewedKyc             KycProfile[]           @relation("ReviewerKyc")
  addresses               UserAddress[]
  providedServices        Service[]
  customerBookings        Booking[]              @relation("CustomerBooking")
  providerBookings        Booking[]              @relation("ProviderBooking")
  reviews                 Review[]
  customerConvos          Conversation[]         @relation("CustomerConvo")
  providerConvos          Conversation[]         @relation("ProviderConvo")
  messages                Message[]
  chatbotSessions         ChatbotSession[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  providerWallet          ProviderWallet?
  withdrawalRequests      WithdrawalRequest[]    @relation("ProviderWithdrawalRequests")
  processedWithdrawals    WithdrawalRequest[]    @relation("WithdrawalProcessor")
  manualDepositRequests   ManualDepositRequest[] @relation("ProviderManualDepositRequests")
  processedManualDeposits ManualDepositRequest[] @relation("ManualDepositProcessor")
  commissionConfigs       CommissionConfig[]
  raisedDisputes          Dispute[]              @relation("DisputeRaisedBy")
  disputeEvidences        DisputeEvidence[]
  featuredListings        FeaturedListing[]
  expoPushToken           String?                @map("expo_push_token") @db.VarChar(255)

  @@index([role, status])
  @@map("users")
}

/// Bảng login_attempts — rate-limit đăng nhập/đổi mật khẩu không phụ thuộc Redis
model LoginAttempt {
  id              Int       @id @default(autoincrement())
  identifier      String    @unique @db.VarChar(180)
  failedCount     Int       @default(0) @map("failed_count")
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  lockedUntil     DateTime? @map("locked_until")
  lastAttemptAt   DateTime  @default(now()) @map("last_attempt_at")

  @@index([lockedUntil])
  @@map("login_attempts")
}

/// Bảng otp_attempts — OTP và cooldown resend lưu trong DB
model OtpAttempt {
  id            Int       @id @default(autoincrement())
  email         String    @db.VarChar(100)
  type          OtpType
  code          String    @db.VarChar(6)
  lastSentAt    DateTime? @map("last_sent_at")
  wrongAttempts Int       @default(0) @map("wrong_attempts")
  ipAddress     String?   @map("ip_address") @db.VarChar(50)
  expiresAt     DateTime  @map("expires_at")

  @@map("otp_attempts")
}

/// Bảng refresh_tokens
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @db.Text
  tokenHash String?  @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

/// Bảng password_resets — link đặt lại mật khẩu dùng 1 lần, 15 phút
model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @db.VarChar(255)
  tokenHash String?  @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

/// Bảng kyc_profiles — KYC status NẰM ĐÂY, không phải trên bảng users
model KycProfile {
  id             Int       @id @default(autoincrement())
  providerId     Int       @map("provider_id")
  cccdFrontUrl   String    @map("cccd_front_url") @db.VarChar(255)
  cccdBackUrl    String    @map("cccd_back_url") @db.VarChar(255)
  portraitUrl    String    @map("portrait_url") @db.VarChar(255)
  certificateUrl String?   @map("certificate_url") @db.VarChar(255)
  status         KycStatus @default(PENDING)
  reviewedBy     Int?      @map("reviewed_by")
  rejectReason   String?   @map("reject_reason") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  provider       User      @relation("ProviderKyc", fields: [providerId], references: [id])
  reviewer       User?     @relation("ReviewerKyc", fields: [reviewedBy], references: [id])

  @@index([providerId])
  @@map("kyc_profiles")
}

/// Bảng user_addresses — có field label ("Nhà riêng", "Văn phòng")
model UserAddress {
  id            Int     @id @default(autoincrement())
  userId        Int     @map("user_id")
  label         String? @db.VarChar(50)
  province      String  @db.VarChar(50)
  district      String  @db.VarChar(50)
  ward          String  @db.VarChar(50)
  addressDetail String  @map("address_detail") @db.Text
  latitude      Decimal @db.Decimal(10, 8)
  longitude     Decimal @db.Decimal(11, 8)
  isDefault     Boolean @default(false) @map("is_default")
  user          User    @relation(fields: [userId], references: [id])

  @@map("user_addresses")
}

/// Bảng service_categories — soft delete dùng is_deleted BOOLEAN
model ServiceCategory {
  id          Int               @id @default(autoincrement())
  name        String            @unique @db.VarChar(100)
  description String?           @db.Text
  isDeleted   Boolean           @default(false) @map("is_deleted")
  services    Service[]

  @@map("service_categories")
}

/// Bảng services — soft delete dùng is_deleted BOOLEAN
model Service {
  id               Int                         @id @default(autoincrement())
  providerId       Int                         @map("provider_id")
  categoryId       Int                         @map("category_id")
  name             String                      @db.VarChar(100)
  description      String                      @db.Text
  referencePrice   Decimal                     @map("reference_price") @db.Decimal(15, 2)
  status           ServiceStatus               @default(DRAFT)
  isSensitive      Boolean                     @default(false) @map("is_sensitive")
  avgRating        Decimal                     @default(0) @map("avg_rating") @db.Decimal(3, 2)
  totalReviews     Int                         @default(0) @map("total_reviews")
  embedding        Unsupported("vector(768)")?
  isDeleted        Boolean                     @default(false) @map("is_deleted")
  provider         User                        @relation(fields: [providerId], references: [id])
  category         ServiceCategory             @relation(fields: [categoryId], references: [id])
  images           ServiceImage[]
  bookings         Booking[]
  reviews          Review[]
  featuredListings FeaturedListing[]
  conversations    Conversation[]
  items            ServiceItem[]

  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @default(now()) @updatedAt @map("updated_at")

  @@index([categoryId, status])
  @@index([providerId])
  @@index([status, isDeleted, avgRating])
  @@index([status, isDeleted, referencePrice])
  @@map("services")
}

/// Bảng service_images — display_order = 0 là ảnh bìa
model ServiceImage {
  id           Int     @id @default(autoincrement())
  serviceId    Int     @map("service_id")
  imageUrl     String  @map("image_url") @db.VarChar(255)
  cloudinaryId String  @map("cloudinary_id") @db.VarChar(255)
  displayOrder Int     @default(0) @map("display_order")
  service      Service @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@map("service_images")
}

/// Bảng bookings — KHÔNG có lat/lng
model Booking {
  id                       Int           @id @default(autoincrement())
  bookingCode              String        @unique @map("booking_code") @db.VarChar(20)
  customerId               Int           @map("customer_id")
  providerId               Int           @map("provider_id")
  serviceId                Int           @map("service_id")
  description              String        @db.Text
  province                 String        @db.VarChar(50)
  district                 String        @db.VarChar(50)
  ward                     String        @db.VarChar(50)
  addressDetail            String        @map("address_detail") @db.Text
  desiredTime              DateTime      @map("desired_time")
  status                   BookingStatus @default(PENDING)
  surveyorName             String?       @map("surveyor_name") @db.VarChar(100)
  surveyorPhone            String?       @map("surveyor_phone") @db.VarChar(15)
  providerAcceptedAt       DateTime?     @map("provider_accepted_at")
  providerArrivedAt        DateTime?     @map("provider_arrived_at")
  providerResponseDeadline DateTime?     @map("provider_response_deadline")
  completedAt              DateTime?     @map("completed_at")
  autoCompletedAt          DateTime?     @map("auto_completed_at")
  createdAt                DateTime      @default(now()) @map("created_at")

  customer           User                   @relation("CustomerBooking", fields: [customerId], references: [id])
  provider           User                   @relation("ProviderBooking", fields: [providerId], references: [id])
  service            Service                @relation(fields: [serviceId], references: [id])
  quotations         Quotation[]
  attachments        BookingAttachment[]
  statusHistories    BookingStatusHistory[]
  conversation       Conversation?
  review             Review?
  dispute            Dispute?
  walletTransactions WalletTransaction[]
  bookingItems       BookingItem[]

  @@index([customerId, status])
  @@index([providerId, status])
  @@index([status, providerAcceptedAt, providerResponseDeadline])
  @@index([bookingCode])
  @@map("bookings")
}

/// Bảng quotations — commission_rate_snapshot chốt cứng % lúc gửi báo giá
model Quotation {
  id                     Int             @id @default(autoincrement())
  bookingId              Int             @map("booking_id")
  actualPrice            Decimal         @map("actual_price") @db.Decimal(15, 2)
  commissionRateSnapshot Decimal         @map("commission_rate_snapshot") @db.Decimal(5, 2)
  estimatedTime          String          @map("estimated_time") @db.VarChar(100)
  note                   String?         @db.Text
  type                   String          @default("ORIGINAL") @db.VarChar(20) // ORIGINAL, SUPPLEMENTARY
  status                 String          @default("ACCEPTED") @db.VarChar(20) // ACCEPTED, PENDING, REJECTED
  booking                Booking         @relation(fields: [bookingId], references: [id])
  quotationItems         QuotationItem[]

  @@map("quotations")
}

/// Bảng booking_attachments — SURVEY = ảnh biên bản, RESULT = ảnh kết quả
model BookingAttachment {
  id        Int                   @id @default(autoincrement())
  bookingId Int                   @map("booking_id")
  type      BookingAttachmentType
  fileUrl   String                @map("file_url") @db.VarChar(255)
  booking   Booking               @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("booking_attachments")
}

/// Bảng booking_status_histories — audit trail đầy đủ
model BookingStatusHistory {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @map("booking_id")
  fromStatus String   @map("from_status") @db.VarChar(50)
  toStatus   String   @map("to_status") @db.VarChar(50)
  changedBy  Int      @map("changed_by")
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("booking_status_histories")
}

/// Bảng provider_wallets — is_restricted = true khi balance âm
model ProviderWallet {
  id           Int                 @id @default(autoincrement())
  providerId   Int                 @unique @map("provider_id")
  balance      Decimal             @default(0) @db.Decimal(15, 2)
  isRestricted Boolean             @default(false) @map("is_restricted")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  provider     User                @relation(fields: [providerId], references: [id])
  transactions WalletTransaction[]

  @@map("provider_wallets")
}

/// Bảng wallet_transactions — vnpay_txn_ref = idempotency key
model WalletTransaction {
  id             Int                     @id @default(autoincrement())
  walletId       Int                     @map("wallet_id")
  type           WalletTransactionType
  amount         Decimal                 @db.Decimal(15, 2)
  bookingId      Int?                    @map("booking_id")
  status         WalletTransactionStatus @default(PENDING)
  vnpayTxnRef    String?                 @map("vnpay_txn_ref") @db.VarChar(100)
  idempotencyKey String?                 @unique @map("idempotency_key") @db.VarChar(140)
  processedAt    DateTime?               @map("processed_at")
  failureReason  String?                 @map("failure_reason") @db.Text
  createdAt      DateTime                @default(now()) @map("created_at")
  wallet         ProviderWallet          @relation(fields: [walletId], references: [id])
  booking        Booking?                @relation(fields: [bookingId], references: [id])
  disputeId      Int?                    @map("dispute_id")
  dispute        Dispute?                @relation(fields: [disputeId], references: [id])

  @@unique([vnpayTxnRef])
  @@index([walletId])
  @@index([bookingId])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id                Int                 @id @default(autoincrement())
  providerId        Int                 @map("provider_id")
  amount            Decimal             @db.Decimal(15, 2)
  bankName          String              @map("bank_name") @db.VarChar(100)
  bankAccountNumber String              @map("bank_account_number") @db.VarChar(50)
  bankAccountHolder String              @map("bank_account_holder") @db.VarChar(100)
  status            WalletRequestStatus @default(PENDING)
  adminNote         String?             @map("admin_note") @db.Text
  processedBy       Int?                @map("processed_by")
  processedAt       DateTime?           @map("processed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  provider          User                @relation("ProviderWithdrawalRequests", fields: [providerId], references: [id])
  processor         User?               @relation("WithdrawalProcessor", fields: [processedBy], references: [id])

  @@index([providerId, status])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

model ManualDepositRequest {
  id           Int                 @id @default(autoincrement())
  providerId   Int                 @map("provider_id")
  amount       Decimal             @db.Decimal(15, 2)
  transferCode String?             @map("transfer_code") @db.VarChar(100)
  receiptUrl   String?             @map("receipt_url") @db.VarChar(255)
  status       WalletRequestStatus @default(PENDING)
  adminNote    String?             @map("admin_note") @db.Text
  processedBy  Int?                @map("processed_by")
  processedAt  DateTime?           @map("processed_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  provider     User                @relation("ProviderManualDepositRequests", fields: [providerId], references: [id])
  processor    User?               @relation("ManualDepositProcessor", fields: [processedBy], references: [id])

  @@index([providerId, status])
  @@index([status, createdAt])
  @@map("manual_deposit_requests")
}

/// Bảng commission_configs — mỗi lần thay đổi tạo record mới (audit trail)
model CommissionConfig {
  id            Int      @id @default(autoincrement())
  rate          Decimal  @db.Decimal(5, 2)
  reason        String?  @db.Text
  configuredBy  Int      @map("configured_by")
  effectiveFrom DateTime @map("effective_from")
  configurator  User     @relation(fields: [configuredBy], references: [id])

  @@map("commission_configs")
}

/// Bảng reviews — chỉ tạo được khi booking DONE + auto_completed_at IS NOT NULL
model Review {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @unique @map("booking_id")
  customerId Int      @map("customer_id")
  serviceId  Int      @map("service_id")
  rating     Int
  comment    String?  @db.Text
  isFlagged  Boolean  @default(false) @map("is_flagged")
  createdAt  DateTime @default(now()) @map("created_at")
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customer   User     @relation(fields: [customerId], references: [id])
  service    Service  @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@index([customerId])
  @@map("reviews")
}

/// Bảng conversations — có thể bắt đầu từ service trước khi có booking
model Conversation {
  id         Int       @id @default(autoincrement())
  bookingId  Int?      @unique @map("booking_id")
  serviceId  Int?      @map("service_id")
  customerId Int       @map("customer_id")
  providerId Int       @map("provider_id")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  booking    Booking?  @relation(fields: [bookingId], references: [id])
  service    Service?  @relation(fields: [serviceId], references: [id])
  customer   User      @relation("CustomerConvo", fields: [customerId], references: [id])
  provider   User      @relation("ProviderConvo", fields: [providerId], references: [id])
  messages   Message[]

  @@unique([customerId, providerId, serviceId])
  @@index([serviceId])
  @@map("conversations")
}

/// Bảng messages — senderId null = AI chatbot
model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  senderId       Int?         @map("sender_id")
  senderType     SenderType
  messageType    String       @default("TEXT") @map("message_type") @db.VarChar(20)
  content        String       @db.Text
  imageUrl       String?      @map("image_url") @db.VarChar(255)
  isRead         Boolean      @default(false) @map("is_read")
  recalledAt     DateTime?    @map("recalled_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User?        @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Server-side memory cho Customer AI Assistant
model ChatbotSession {
  id        String                  @id @default(cuid())
  userId    Int                     @map("user_id")
  title     String?                 @db.VarChar(120)
  summary   String?                 @db.Text
  state     Json?
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatbotSessionMessage[]

  @@index([userId, updatedAt])
  @@map("chatbot_sessions")
}

/// Tin nhắn ngắn hạn của chatbot, dùng để dựng lại ngữ cảnh gần nhất
model ChatbotSessionMessage {
  id        Int            @id @default(autoincrement())
  sessionId String         @map("session_id")
  role      String         @db.VarChar(20)
  content   String         @db.Text
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at")
  session   ChatbotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chatbot_session_messages")
}

/// Bảng notifications
model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  content     String   @db.Text
  referenceId Int?     @map("reference_id")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

/// Bảng audit_logs — ip_address bắt buộc để security audit
model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int      @map("actor_id")
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(50)
  targetId    Int      @map("target_id")
  description String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User     @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

/// Bảng disputes — status: PENDING → IN_REVIEW → RESOLVED
model Dispute {
  id                 Int                 @id @default(autoincrement())
  bookingId          Int                 @unique @map("booking_id")
  raisedBy           Int                 @map("raised_by")
  assignedTo         Int?                @map("assigned_to")
  reason             String              @db.Text
  status             DisputeStatus       @default(PENDING)
  resolutionAction   String?             @map("resolution_action")
  resolutionReason   String?             @map("resolution_reason") @db.Text
  aiSummary          String?             @map("ai_summary") @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  booking            Booking             @relation(fields: [bookingId], references: [id])
  raisedByUser       User                @relation("DisputeRaisedBy", fields: [raisedBy], references: [id])
  evidences          DisputeEvidence[]
  walletTransactions WalletTransaction[]

  @@map("disputes")
}

/// Bảng dispute_evidences
model DisputeEvidence {
  id         Int                 @id @default(autoincrement())
  disputeId  Int                 @map("dispute_id")
  type       DisputeEvidenceType
  fileUrl    String              @map("file_url") @db.VarChar(255)
  uploadedBy Int                 @map("uploaded_by")
  dispute    Dispute             @relation(fields: [disputeId], references: [id])
  uploader   User                @relation(fields: [uploadedBy], references: [id])

  @@map("dispute_evidences")
}

/// Bảng system_settings — Lưu trữ cấu hình hệ thống (hoa hồng, etc.)
model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Bảng featured_listings — NCC trả phí để đẩy dịch vụ lên Top
model FeaturedListing {
  id         Int                   @id @default(autoincrement())
  serviceId  Int                   @map("service_id")
  providerId Int                   @map("provider_id")
  startDate  DateTime              @map("start_date")
  endDate    DateTime              @map("end_date")
  dailyRate  Decimal               @map("daily_rate") @db.Decimal(15, 2)
  totalCost  Decimal               @map("total_cost") @db.Decimal(15, 2)
  status     FeaturedListingStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  service    Service               @relation(fields: [serviceId], references: [id])
  provider   User                  @relation(fields: [providerId], references: [id])

  @@index([status, endDate])
  @@index([serviceId])
  @@map("featured_listings")
}

model ServiceItem {
  id           Int           @id @default(autoincrement())
  serviceId    Int           @map("service_id")
  name         String        @db.VarChar(100)
  unit         String        @db.VarChar(20)
  price        Decimal       @db.Decimal(15, 2)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@map("service_items")
}

model BookingItem {
  id            Int          @id @default(autoincrement())
  bookingId     Int          @map("booking_id")
  serviceItemId Int?         @map("service_item_id")
  name          String       @db.VarChar(100)
  unit          String       @db.VarChar(20)
  quantity      Int          @default(1)
  priceSnapshot Decimal      @map("price_snapshot") @db.Decimal(15, 2)
  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceItem   ServiceItem? @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  @@map("booking_items")
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int       @map("quotation_id")
  name        String    @db.VarChar(100)
  unit        String    @db.VarChar(20)
  price       Decimal   @db.Decimal(15, 2)
  quantity    Int       @default(1)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}
