// ===== GENERATOR & DATASOURCE =====
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ===== ENUMS =====
enum UserRole {
  ADMIN
  STAFF
  PROVIDER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  LOCKED
  PENDING
}

enum OtpType {
  REGISTER
  RESET_PASSWORD
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceStatus {
  DRAFT
  PENDING
  ACTIVE
  HIDDEN
  REJECTED
}

enum BookingStatus {
  PENDING
  QUOTED
  CONFIRMED
  IN_PROGRESS
  DONE
  DISPUTED
  CANCELLED
}

enum BookingAttachmentType {
  SURVEY
  RESULT
}

enum WalletTransactionType {
  DEPOSIT
  COMMISSION
  PENALTY
  FEATURED_FEE
}

enum WalletTransactionStatus {
  SUCCESS
  FAILED
  PENDING
}

enum SenderType {
  CUSTOMER
  PROVIDER
  AI
}

enum DisputeStatus {
  PENDING
  IN_REVIEW
  RESOLVED
}

enum DisputeEvidenceType {
  IMAGE
  VIDEO
}

enum FeaturedListingStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ===== MODELS =====

/// Bảng users — KHÔNG có kycStatus, isLocked, lockUntil, deletedAt
model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique @db.VarChar(100)
  password      String?    @db.VarChar(255)
  googleId      String?    @unique @map("google_id") @db.VarChar(100)
  fullName      String     @db.VarChar(100) @map("full_name")
  phone         String?    @db.VarChar(15)
  avatarUrl     String?    @db.VarChar(255) @map("avatar_url")
  role          UserRole
  status        UserStatus @default(PENDING)
  emailVerified Boolean    @default(false) @map("email_verified")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relations
  refreshTokens    RefreshToken[]
  passwordResets   PasswordReset[]
  kycProfiles      KycProfile[]      @relation("ProviderKyc")
  reviewedKyc      KycProfile[]      @relation("ReviewerKyc")
  addresses        UserAddress[]
  providedServices Service[]
  customerBookings Booking[]         @relation("CustomerBooking")
  providerBookings Booking[]         @relation("ProviderBooking")
  reviews          Review[]
  customerConvos   Conversation[]    @relation("CustomerConvo")
  providerConvos   Conversation[]    @relation("ProviderConvo")
  messages         Message[]
  chatbotSessions  ChatbotSession[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  providerWallet   ProviderWallet?
  commissionConfigs CommissionConfig[]
  raisedDisputes   Dispute[]         @relation("DisputeRaisedBy")
  disputeEvidences DisputeEvidence[]
  featuredListings FeaturedListing[]
  expoPushToken    String?           @db.VarChar(255) @map("expo_push_token")

  @@map("users")
  @@index([role, status])
}

/// Bảng login_attempts — rate-limit đăng nhập/đổi mật khẩu không phụ thuộc Redis
model LoginAttempt {
  id              Int       @id @default(autoincrement())
  identifier      String    @unique @db.VarChar(180)
  failedCount     Int       @default(0) @map("failed_count")
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  lockedUntil     DateTime? @map("locked_until")
  lastAttemptAt   DateTime  @default(now()) @map("last_attempt_at")

  @@map("login_attempts")
  @@index([lockedUntil])
}

/// Bảng otp_attempts — OTP và cooldown resend lưu trong DB
model OtpAttempt {
  id            Int       @id @default(autoincrement())
  email         String    @db.VarChar(100)
  type          OtpType
  code          String    @db.VarChar(6)
  lastSentAt    DateTime? @map("last_sent_at")
  wrongAttempts Int       @default(0) @map("wrong_attempts")
  ipAddress     String?   @db.VarChar(50) @map("ip_address")
  expiresAt     DateTime  @map("expires_at")

  @@map("otp_attempts")
}

/// Bảng refresh_tokens
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @db.Text
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

/// Bảng password_resets — link đặt lại mật khẩu dùng 1 lần, 15 phút
model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

/// Bảng kyc_profiles — KYC status NẰM ĐÂY, không phải trên bảng users
model KycProfile {
  id             Int       @id @default(autoincrement())
  providerId     Int       @map("provider_id")
  cccdFrontUrl   String    @db.VarChar(255) @map("cccd_front_url")
  cccdBackUrl    String    @db.VarChar(255) @map("cccd_back_url")
  portraitUrl    String    @db.VarChar(255) @map("portrait_url")
  certificateUrl String?   @db.VarChar(255) @map("certificate_url")
  status         KycStatus @default(PENDING)
  reviewedBy     Int?      @map("reviewed_by")
  rejectReason   String?   @db.Text @map("reject_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  provider       User      @relation("ProviderKyc", fields: [providerId], references: [id])
  reviewer       User?     @relation("ReviewerKyc", fields: [reviewedBy], references: [id])

  @@map("kyc_profiles")
}

/// Bảng user_addresses — có field label ("Nhà riêng", "Văn phòng")
model UserAddress {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  label         String?  @db.VarChar(50)
  province      String   @db.VarChar(50)
  district      String   @db.VarChar(50)
  ward          String   @db.VarChar(50)
  addressDetail String   @db.Text @map("address_detail")
  latitude      Decimal  @db.Decimal(10, 8)
  longitude     Decimal  @db.Decimal(11, 8)
  isDefault     Boolean  @default(false) @map("is_default")
  user          User     @relation(fields: [userId], references: [id])

  @@map("user_addresses")
}

/// Bảng service_categories — soft delete dùng is_deleted BOOLEAN
model ServiceCategory {
  id          Int               @id @default(autoincrement())
  name        String            @unique @db.VarChar(100)
  description String?           @db.Text
  parentId    Int?              @map("parent_id")
  level       Int               @default(1)
  isDeleted   Boolean           @default(false) @map("is_deleted")
  parent      ServiceCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ServiceCategory[] @relation("CategoryTree")
  services    Service[]

  @@map("service_categories")
}

/// Bảng services — soft delete dùng is_deleted BOOLEAN
model Service {
  id             Int           @id @default(autoincrement())
  providerId     Int           @map("provider_id")
  categoryId     Int           @map("category_id")
  name           String        @db.VarChar(100)
  description    String        @db.Text
  referencePrice Decimal       @db.Decimal(15, 2) @map("reference_price")
  status         ServiceStatus @default(DRAFT)
  isSensitive    Boolean       @default(false) @map("is_sensitive")
  avgRating      Decimal       @default(0) @db.Decimal(3, 2) @map("avg_rating")
  totalReviews   Int           @default(0) @map("total_reviews")
  embedding      Unsupported("vector(768)")?
  isDeleted      Boolean       @default(false) @map("is_deleted")
  provider       User          @relation(fields: [providerId], references: [id])
  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  images         ServiceImage[]
  bookings       Booking[]
  reviews        Review[]
  featuredListings FeaturedListing[]
  conversations  Conversation[]

  @@map("services")
  @@index([categoryId, status])
  @@index([providerId])
}

/// Bảng service_images — display_order = 0 là ảnh bìa
model ServiceImage {
  id           Int     @id @default(autoincrement())
  serviceId    Int     @map("service_id")
  imageUrl     String  @db.VarChar(255) @map("image_url")
  cloudinaryId String  @db.VarChar(255) @map("cloudinary_id")
  displayOrder Int     @default(0) @map("display_order")
  service      Service @relation(fields: [serviceId], references: [id])

  @@map("service_images")
}

/// Bảng bookings — KHÔNG có lat/lng
model Booking {
  id              Int           @id @default(autoincrement())
  bookingCode     String        @unique @db.VarChar(20) @map("booking_code")
  customerId      Int           @map("customer_id")
  providerId      Int           @map("provider_id")
  serviceId       Int           @map("service_id")
  description     String        @db.Text
  province        String        @db.VarChar(50)
  district        String        @db.VarChar(50)
  ward            String        @db.VarChar(50)
  addressDetail   String        @db.Text @map("address_detail")
  desiredTime     DateTime      @map("desired_time")
  status          BookingStatus @default(PENDING)
  surveyorName    String?       @db.VarChar(100) @map("surveyor_name")
  surveyorPhone   String?       @db.VarChar(15) @map("surveyor_phone")
  completedAt     DateTime?     @map("completed_at")
  autoCompletedAt DateTime?     @map("auto_completed_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  customer        User          @relation("CustomerBooking", fields: [customerId], references: [id])
  provider        User          @relation("ProviderBooking", fields: [providerId], references: [id])
  service         Service       @relation(fields: [serviceId], references: [id])
  quotation       Quotation?
  attachments     BookingAttachment[]
  statusHistories BookingStatusHistory[]
  conversation    Conversation?
  review          Review?
  dispute         Dispute?
  walletTransactions WalletTransaction[]

  @@map("bookings")
  @@index([customerId, status])
  @@index([providerId, status])
  @@index([bookingCode])
}

/// Bảng quotations — commission_rate_snapshot chốt cứng % lúc gửi báo giá
model Quotation {
  id                     Int     @id @default(autoincrement())
  bookingId              Int     @unique @map("booking_id")
  actualPrice            Decimal @db.Decimal(15, 2) @map("actual_price")
  commissionRateSnapshot Decimal @db.Decimal(5, 2) @map("commission_rate_snapshot")
  estimatedTime          String  @db.VarChar(100) @map("estimated_time")
  note                   String? @db.Text
  booking                Booking @relation(fields: [bookingId], references: [id])

  @@map("quotations")
}

/// Bảng booking_attachments — SURVEY = ảnh biên bản, RESULT = ảnh kết quả
model BookingAttachment {
  id        Int                   @id @default(autoincrement())
  bookingId Int                   @map("booking_id")
  type      BookingAttachmentType
  fileUrl   String                @db.VarChar(255) @map("file_url")
  booking   Booking               @relation(fields: [bookingId], references: [id])

  @@map("booking_attachments")
}

/// Bảng booking_status_histories — audit trail đầy đủ
model BookingStatusHistory {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @map("booking_id")
  fromStatus String   @db.VarChar(50) @map("from_status")
  toStatus   String   @db.VarChar(50) @map("to_status")
  changedBy  Int      @map("changed_by")
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@map("booking_status_histories")
}

/// Bảng provider_wallets — is_restricted = true khi balance âm
model ProviderWallet {
  id           Int      @id @default(autoincrement())
  providerId   Int      @unique @map("provider_id")
  balance      Decimal  @default(0) @db.Decimal(15, 2)
  isRestricted Boolean  @default(false) @map("is_restricted")
  updatedAt    DateTime @updatedAt @map("updated_at")
  provider     User     @relation(fields: [providerId], references: [id])
  transactions WalletTransaction[]

  @@map("provider_wallets")
}

/// Bảng wallet_transactions — vnpay_txn_ref = idempotency key
model WalletTransaction {
  id          Int                     @id @default(autoincrement())
  walletId    Int                     @map("wallet_id")
  type        WalletTransactionType
  amount      Decimal                 @db.Decimal(15, 2)
  bookingId   Int?                    @map("booking_id")
  status      WalletTransactionStatus @default(PENDING)
  vnpayTxnRef String?                 @db.VarChar(100) @map("vnpay_txn_ref")
  createdAt   DateTime                @default(now()) @map("created_at")
  wallet      ProviderWallet          @relation(fields: [walletId], references: [id])
  booking     Booking?                @relation(fields: [bookingId], references: [id])
  disputeId   Int?                    @map("dispute_id")
  dispute     Dispute?                @relation(fields: [disputeId], references: [id])

  @@map("wallet_transactions")
}

/// Bảng commission_configs — mỗi lần thay đổi tạo record mới (audit trail)
model CommissionConfig {
  id            Int      @id @default(autoincrement())
  rate          Decimal  @db.Decimal(5, 2)
  reason        String?  @db.Text
  configuredBy  Int      @map("configured_by")
  effectiveFrom DateTime @map("effective_from")
  configurator  User     @relation(fields: [configuredBy], references: [id])

  @@map("commission_configs")
}

/// Bảng reviews — chỉ tạo được khi booking DONE + auto_completed_at IS NOT NULL
model Review {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @unique @map("booking_id")
  customerId Int      @map("customer_id")
  serviceId  Int      @map("service_id")
  rating     Int
  comment    String?  @db.Text
  isFlagged  Boolean  @default(false) @map("is_flagged")
  createdAt  DateTime @default(now()) @map("created_at")
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customer   User     @relation(fields: [customerId], references: [id])
  service    Service  @relation(fields: [serviceId], references: [id])

  @@map("reviews")
  @@index([serviceId])
  @@index([customerId])
}

/// Bảng conversations — có thể bắt đầu từ service trước khi có booking
model Conversation {
  id         Int       @id @default(autoincrement())
  bookingId  Int?      @unique @map("booking_id")
  serviceId  Int?      @map("service_id")
  customerId Int       @map("customer_id")
  providerId Int       @map("provider_id")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  booking    Booking?  @relation(fields: [bookingId], references: [id])
  service    Service?  @relation(fields: [serviceId], references: [id])
  customer   User      @relation("CustomerConvo", fields: [customerId], references: [id])
  provider   User      @relation("ProviderConvo", fields: [providerId], references: [id])
  messages   Message[]

  @@map("conversations")
  @@unique([customerId, providerId, serviceId])
  @@index([serviceId])
}

/// Bảng messages — senderId null = AI chatbot
model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  senderId       Int?         @map("sender_id")
  senderType     SenderType
  content        String       @db.Text
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User?        @relation(fields: [senderId], references: [id])

  @@map("messages")
}

/// Server-side memory cho Customer AI Assistant
model ChatbotSession {
  id        String                  @id @default(cuid())
  userId    Int                     @map("user_id")
  title     String?                 @db.VarChar(120)
  summary   String?                 @db.Text
  state     Json?
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatbotSessionMessage[]

  @@map("chatbot_sessions")
  @@index([userId, updatedAt])
}

/// Tin nhắn ngắn hạn của chatbot, dùng để dựng lại ngữ cảnh gần nhất
model ChatbotSessionMessage {
  id        Int            @id @default(autoincrement())
  sessionId String         @map("session_id")
  role      String         @db.VarChar(20)
  content   String         @db.Text
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at")
  session   ChatbotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chatbot_session_messages")
  @@index([sessionId, createdAt])
}

/// Bảng notifications
model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  content     String   @db.Text
  referenceId Int?     @map("reference_id")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

/// Bảng audit_logs — ip_address bắt buộc để security audit
model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int      @map("actor_id")
  action      String   @db.VarChar(100)
  targetType  String   @db.VarChar(50) @map("target_type")
  targetId    Int      @map("target_id")
  description String?  @db.Text
  ipAddress   String?  @db.VarChar(50) @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User     @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

/// Bảng disputes — status: PENDING → IN_REVIEW → RESOLVED
model Dispute {
  id               Int           @id @default(autoincrement())
  bookingId        Int           @unique @map("booking_id")
  raisedBy         Int           @map("raised_by")
  assignedTo       Int?          @map("assigned_to")
  reason           String        @db.Text
  status           DisputeStatus @default(PENDING)
  resolutionAction String?       @map("resolution_action")
  resolutionReason String?       @db.Text @map("resolution_reason")
  aiSummary        String?       @db.Text @map("ai_summary")
  createdAt        DateTime      @default(now()) @map("created_at")
  booking          Booking       @relation(fields: [bookingId], references: [id])
  raisedByUser     User          @relation("DisputeRaisedBy", fields: [raisedBy], references: [id])
  evidences        DisputeEvidence[]
  walletTransactions WalletTransaction[]

  @@map("disputes")
}

/// Bảng dispute_evidences
model DisputeEvidence {
  id         Int                 @id @default(autoincrement())
  disputeId  Int                 @map("dispute_id")
  type       DisputeEvidenceType
  fileUrl    String              @db.VarChar(255) @map("file_url")
  uploadedBy Int                 @map("uploaded_by")
  dispute    Dispute             @relation(fields: [disputeId], references: [id])
  uploader   User                @relation(fields: [uploadedBy], references: [id])

  @@map("dispute_evidences")
}

/// Bảng system_settings — Lưu trữ cấu hình hệ thống (hoa hồng, etc.)
model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Bảng featured_listings — NCC trả phí để đẩy dịch vụ lên Top
model FeaturedListing {
  id          Int                   @id @default(autoincrement())
  serviceId   Int                   @map("service_id")
  providerId  Int                   @map("provider_id")
  startDate   DateTime              @map("start_date")
  endDate     DateTime              @map("end_date")
  dailyRate   Decimal               @db.Decimal(15, 2) @map("daily_rate")
  totalCost   Decimal               @db.Decimal(15, 2) @map("total_cost")
  status      FeaturedListingStatus @default(ACTIVE)
  createdAt   DateTime              @default(now()) @map("created_at")
  service     Service               @relation(fields: [serviceId], references: [id])
  provider    User                  @relation(fields: [providerId], references: [id])

  @@map("featured_listings")
  @@index([status, endDate])
  @@index([serviceId])
}
