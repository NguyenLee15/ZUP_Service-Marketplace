# Server-only BFF target. Never expose this as NEXT_PUBLIC_*.
BACKEND_URL=http://localhost:3001

# Server-only Gemini key for Vercel AI SDK routes. Do not prefix with NEXT_PUBLIC_*.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Browser WebSocket target. For VPS/domain demo, set this to the public backend URL.
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Public OAuth client id.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
