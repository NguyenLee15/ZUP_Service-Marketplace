# Server-only BFF target. Never expose this as NEXT_PUBLIC_*.
BACKEND_URL=http://localhost:3001

# Public frontend origin used for canonical URLs, CSP and OAuth origins.
# Production example: https://your-frontend.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Gemini key for Vercel AI SDK routes. Do not prefix with NEXT_PUBLIC_*.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Browser WebSocket target. Production should be the deployed backend origin.
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Public OAuth client id.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
