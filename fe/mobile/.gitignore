# Nếu dùng bare workflow thì bỏ 2 dòng này
# ─────────────────────────────────────────────
/android/
/ios/

# ─────────────────────────────────────────────
# Build artifacts
# ─────────────────────────────────────────────
*.apk
*.aab
*.ipa
*.app
build/
output/

# ─────────────────────────────────────────────
# Secrets & Keys (TUYỆT ĐỐI KHÔNG COMMIT)
# ─────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production

# Giữ lại file mẫu để team biết cần những biến gì
# .env.example  ← KHÔNG ignore (cần commit)

# Android signing keys
*.keystore
*.jks

# iOS signing
*.p8
*.p12
*.key
*.mobileprovision
*.certSigningRequest
*.cer

# Google services (chứa API key)
google-services.json
GoogleService-Info.plist

# ─────────────────────────────────────────────
# Metro bundler
# ─────────────────────────────────────────────
.metro-health-check*
.metro-cache/

# ─────────────────────────────────────────────
# TypeScript
# ─────────────────────────────────────────────
*.tsbuildinfo
*.d.ts.map

# ─────────────────────────────────────────────
# Debug logs
# ─────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ─────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────
# IDE / Editor
# ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─────────────────────────────────────────────
# Test / Coverage
# ─────────────────────────────────────────────
coverage/
.jest-cache/
jest_html_reporters.html
test-results/

# ─────────────────────────────────────────────
# Kotlin (Android build cache)
# ─────────────────────────────────────────────
.kotlin/

# ─────────────────────────────────────────────
