node_modules/
.pnp
.pnp.js

# ─────────────────────────────────────────────
# Expo / EAS
# ─────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# EAS local credentials (KHÔNG commit - dùng eas credentials)
credentials.json
*-credentials.json

# ─────────────────────────────────────────────
