{
  "expo": {
    "name": "Zup Đối Tác",
    "slug": "homeservice-provider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": [
      "homeservice-provider",
      "com.googleusercontent.apps.422532889022-io4134s1uuc7nstujs97grm3qagfnb2e"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E40AF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homeservice.provider"
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBPUVlevpey_vgJF24CRNqQzhYvwDP8wwA"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E40AF"
      },
      "package": "com.homeservice.provider",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.NFC",
        "android.permission.BIND_NFC_SERVICE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Ứng dụng cần quyền NFC để đọc thông tin thẻ CCCD gắn chip."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập ảnh để tải lên hình ảnh dịch vụ và biên bản khảo sát.",
          "cameraPermission": "Ứng dụng cần truy cập camera để chụp ảnh biên bản khảo sát và kết quả công việc."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần truy cập camera để quét mã QR và xác thực CCCD."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1E40AF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "proguardRules": "./proguard-rules.pro",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ứng dụng cần quyền truy cập vị trí để xác định địa chỉ hoạt động của bạn.",
          "locationWhenInUsePermission": "Ứng dụng cần quyền truy cập vị trí để xác định địa chỉ hoạt động của bạn."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bef8a973-2515-45d8-ab0b-8dcab21cb930"
      }
    }
  }
}