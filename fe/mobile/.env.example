# Expo public API URL is bundled into the mobile app.
# Local emulator Android: http://10.0.2.2:3001
# Real phone cùng Wi-Fi/hotspot: http://<LAPTOP_IPV4>:3001
# Public demo/Render: https://<render-backend-url>
EXPO_PUBLIC_API_URL=https://service-marketplace-prod-free.onrender.com

# Optional Google OAuth client ids for provider login.
# Android builds need EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID or the Google button is hidden.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=422532889022-io4134s1uuc7nstujs97grm3qagfnb2e.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: only set these when manual provider deposits are ready for real operations.
# If any value is empty, the provider app hides manual transfer deposits and keeps VNPay sandbox only.
EXPO_PUBLIC_PROVIDER_DEPOSIT_BANK_NAME=
EXPO_PUBLIC_PROVIDER_DEPOSIT_ACCOUNT_NUMBER=
EXPO_PUBLIC_PROVIDER_DEPOSIT_ACCOUNT_HOLDER=
