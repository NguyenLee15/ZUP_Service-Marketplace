{
  "expo": {
    "name": "HomeServe",
    "slug": "homeservice-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": [
      "homeservice-customer",
      "com.googleusercontent.apps.422532889022-3r7vkh1lrvutq4ip3e639nska0537s02"
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homeservice.customer"
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD0K0JX_cUHSvRYA1RzeV5z46TvccQXQPY"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B7CFF"
      },
      "package": "com.homeservice.customer",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập ảnh để cập nhật hồ sơ, gửi tranh chấp và đánh giá dịch vụ.",
          "cameraPermission": "Ứng dụng cần truy cập camera để chụp ảnh minh chứng khi cần hỗ trợ đơn hàng."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B7CFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "proguardRules": "./proguard-rules.pro",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ứng dụng cần quyền truy cập vị trí để tìm dịch vụ gần bạn nhất."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97fcfc43-b00f-4822-a7f2-ffdc47615f84"
      }
    },
    "owner": "leee15"
  }
}
